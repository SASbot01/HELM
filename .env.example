# ============================================
# FBA Academy Dashboard - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# These are also needed in Vercel Dashboard → Settings → Environment Variables

# Supabase (get from: supabase.com → Project → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# Webhook Security (generate a random string for the API key)
WEBHOOK_API_KEY=your-secret-api-key-here

# Anthropic AI Agent (get from: console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-api03-...your-anthropic-key

# Google Maps Places API (get from: console.cloud.google.com → APIs & Services → Credentials)
# Required for the Prospector Agent to search businesses on Google Maps
# Enable "Places API" in your Google Cloud project
GOOGLE_MAPS_API_KEY=AIza...your-google-maps-key

# Vite env vars (for the frontend to call the API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
VITE_API_URL=https://your-app.vercel.app

# ── Google (Calendar + Drive) ───────────────────────────────────────────────
# Credenciales de LA aplicación de Google de HELM (una sola para todo el
# proyecto; cada perfil conecta su cuenta desde Ajustes → Integraciones).
# Cómo crearlas, paso a paso: docs/google-app.md
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Credenciales de LA aplicación de Instagram de HELM (una sola para todo el
# proyecto; cada perfil conecta su cuenta desde Contenido → Conectar con
# Instagram). Sin ellas, la sección Contenido sigue funcionando pegando a mano
# un token de larga duración. Cómo crearlas: docs/instagram-app.md
IG_APP_ID=...
IG_APP_SECRET=...
# Setter de Instagram (api/ig-webhook.js): el token que se pone en Meta al dar
# de alta el webhook. Una cadena larga al azar. Ver docs/setter-instagram.md
IG_WEBHOOK_VERIFY_TOKEN=...

# URL pública de HELM. La usan el webhook de Stripe y, sobre todo, los redirect
# de Google e Instagram: tienen que coincidir EXACTAMENTE con los registrados
# en Google Cloud y en el panel de Meta.
HELM_PUBLIC_URL=https://tu-helm.com

# Bot de Telegram de HELM para las agencias (api/telegram-agencia.js): uno solo
# para el administrador de cada agencia y todos sus perfiles. El token sale de
# @BotFather; el secreto lo inventas tú (letras, números, _ y -, hasta 256) y
# Telegram lo manda en cada update (solo lo usa helm-api). El worker
# (helm-agents), que avisa por este bot, necesita HELM_TELEGRAM_TOKEN y, si se
# cambia, HELM_TELEGRAM_AGENCIAS (hoy los dos servicios leen el mismo
# .env.server). Tras definirlas, la plataforma registra el webhook con
# POST /api/telegram-agencia?action=registrar.
HELM_TELEGRAM_TOKEN=
HELM_TELEGRAM_SECRETO=
# Opcionales: el modelo de Claude del bot (por defecto claude-sonnet-5) y los
# slugs de las agencias que pueden usarlo, separados por comas (por defecto
# silvestreai).
HELM_TELEGRAM_MODELO=
HELM_TELEGRAM_AGENCIAS=

# Jev (TypeSafe): modelo de decisión para clasificar (api/_lib/jev.js). Opcional.
# Con clave, etiqueta los reels cuando Claude no está disponible, antes que el
# modelo local. La clave se saca en console.typesafe.ai/keys.
TYPESAFE_API_KEY=
